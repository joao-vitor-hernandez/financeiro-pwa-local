# ==============================================================================
# .gitignore - Sistema Financeiro Pessoal PWA
# Blindagem contra vazamento de credenciais, dados pessoais e artefatos de build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Segredos, Credenciais e Variáveis de Ambiente (CRÍTICO - NUNCA REMOVER)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
token.json
cloudflared-cert.json
cert.pem
*.tunnel.json
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ------------------------------------------------------------------------------
# 2. Banco de Dados, Dumps e Dados Pessoais
# ------------------------------------------------------------------------------
*.sql
*.sql.gz
*.sql.age
*.dump
*.tar
*.db
*.sqlite
*.sqlite3
postgres-data/
data/
backups/
*.backup

# ------------------------------------------------------------------------------
# 3. Python (FastAPI / Pytest / Virtualenv)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
eggs/
.eggs/

# ------------------------------------------------------------------------------
# 4. Node.js & Angular (Frontend PWA)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.angular/
dist/
tmp/
out-tsc/
.sass-cache/

# ------------------------------------------------------------------------------
# 5. IDEs, Editores e Arquivos do Sistema Operacional
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 6. Logs e Temporários
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
