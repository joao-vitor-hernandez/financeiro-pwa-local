# ==============================================================================
# .env.example - Modelo de Variáveis de Ambiente
# COPIE ESTE ARQUIVO PARA .env E PREENCHA COM SEUS VALORES REAIS
# NUNCA FAÇA COMMIT DO ARQUIVO .env NO GITHUB!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Gerais do Ambiente
# ------------------------------------------------------------------------------
ENVIRONMENT=development             # development | production
APP_NAME="Financeiro PWA"
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL (Local ou Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=financeiro_db
POSTGRES_HOST=localhost            # Em docker interno, use 'postgres'
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. Autenticação & Segurança da API
# ------------------------------------------------------------------------------
# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=sua_chave_secreta_jwt_minimo_32_caracteres_aqui
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. Open Finance (Pluggy API)
# ------------------------------------------------------------------------------
PLUGGY_CLIENT_ID=seu_client_id_pluggy_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_pluggy_aqui
PLUGGY_BASE_URL=https://api.pluggy.ai

# ------------------------------------------------------------------------------
# 5. Backup Criptografado & Cloudflare R2
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=seu_account_id_cloudflare
R2_ACCESS_KEY_ID=sua_access_key_r2
R2_SECRET_ACCESS_KEY=sua_secret_access_key_r2
R2_BUCKET_NAME=financeiro-backups
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Chave pública para criptografia assimétrica de backup com 'age'
# (A chave privada NUNCA deve ser configurada aqui; guarde-a em local offline seguro)
AGE_PUBLIC_KEY=age1suachavepublicaaqui...

# ------------------------------------------------------------------------------
# 6. Cloudflare Tunnel (cloudflared)
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=seu_token_do_cloudflare_tunnel_aqui
