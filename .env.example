# ==============================================================================
# .env.example - Modelo de Variáveis de Ambiente
# COPIE ESTE ARQUIVO PARA .env E PREENCHA COM SEUS VALORES REAIS
# NUNCA FAÇA COMMIT DO ARQUIVO .env NO GITHUB!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Gerais do Ambiente
# ------------------------------------------------------------------------------
ENVIRONMENT=development             # development | production
APP_NAME="Financeiro PWA"
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Banco de Dados PostgreSQL (Local ou Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=financeiro_db
POSTGRES_HOST=localhost            # Em docker interno, use 'postgres'
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. Autenticação & Segurança da API
# ------------------------------------------------------------------------------
# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=sua_chave_secreta_jwt_minimo_32_caracteres_aqui
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ------------------------------------------------------------------------------
# 4. Open Finance (Pluggy API)
# ------------------------------------------------------------------------------
PLUGGY_CLIENT_ID=seu_client_id_pluggy_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_pluggy_aqui
PLUGGY_BASE_URL=https://api.pluggy.ai

# ------------------------------------------------------------------------------
# 5. API Oficial Mercado Pago (Fase 2)
# ------------------------------------------------------------------------------
# Token obtido no Portal de Desenvolvedores do Mercado Pago (mercadopago.com.br/developers)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu_token_aqui
MERCADOPAGO_USER_ID=seu_user_id_aqui
MERCADOPAGO_BASE_URL=https://api.mercadopago.com

# ------------------------------------------------------------------------------
# 6. API Oficial Banco Inter com mTLS (Fase 3)
# ------------------------------------------------------------------------------
# Credenciais e certificados gerados no Internet Banking do Inter (developers.inter.co)
# NUNCA faça commit dos arquivos .key e .crt! Mantenha-os protegidos no host local
INTER_CLIENT_ID=seu_client_id_inter_aqui
INTER_CLIENT_SECRET=seu_client_secret_inter_aqui
INTER_CERT_PATH=/caminho/seguro/para/certificado_inter.crt
INTER_KEY_PATH=/caminho/seguro/para/chave_inter.key
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br

# ------------------------------------------------------------------------------
# 7. Backup Criptografado & Cloudflare R2
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=seu_account_id_cloudflare
R2_ACCESS_KEY_ID=sua_access_key_r2
R2_SECRET_ACCESS_KEY=sua_secret_access_key_r2
R2_BUCKET_NAME=financeiro-backups
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Chave pública para criptografia assimétrica de backup com 'age'
# (A chave privada NUNCA deve ser configurada aqui; guarde-a em local offline seguro)
AGE_PUBLIC_KEY=age1suachavepublicaaqui...

# ------------------------------------------------------------------------------
# 8. Cloudflare Tunnel (cloudflared)
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=seu_token_do_cloudflare_tunnel_aqui

# ------------------------------------------------------------------------------
# 9. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:seu_email@dominio.com
